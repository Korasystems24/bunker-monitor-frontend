# URL реального FastAPI backend, включая версионный префикс API.
# Открывается из браузера напрямую (см. src/api/client.ts) — при запуске на сервере
# разработки через Docker Compose здесь должен быть адрес самого сервера
# (http://<адрес-сервера>:8000/api/v1), а не localhost и не имя docker-сервиса.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Только для Vite dev proxy внутри Docker. При локальном npm run dev не задавать.
# VITE_API_PROXY_TARGET=http://host.docker.internal:8000

# Интервал polling live-данных (мс). По ТЗ время отклика ≤ 1с, рекомендуем 1000-2000
VITE_POLL_INTERVAL_MS=1500

# true = показывать индикатор "MOCK" в статус-баре
VITE_MOCK_MODE=false

# Порты, которые publish'ит docker-compose.yml на хосте (не переменные Vite/приложения).
# Поменять при конфликте с другим проектом на том же сервере разработки.
FRONTEND_PORT=5173
